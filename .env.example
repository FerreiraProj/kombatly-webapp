# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://taekwombats:taekwombats_dev@localhost:5432/taekwombats"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ============================================
# EMAIL (Purelymail SMTP)
# ============================================
SMTP_HOST="smtp.purelymail.com"
SMTP_PORT=587
SMTP_USER="noreply@taekwombats.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Taekwombats <noreply@taekwombats.com>"

# ============================================
# PUSH NOTIFICATIONS (VAPID)
# ============================================
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@taekwombats.com"

# ============================================
# APP URLS
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
FRONTEND_URL="http://localhost:3000"
API_PORT=3001

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ============================================
# OPENAI (for regulation translation)
# ============================================
OPENAI_API_KEY="sk-..."
