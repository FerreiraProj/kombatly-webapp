FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter=@taekwombats/database exec prisma generate
RUN pnpm --filter=@taekwombats/api build
EXPOSE 3001
CMD ["sh", "-c", "pnpm --filter=@taekwombats/database exec prisma migrate deploy && node apps/api/dist/main"]
