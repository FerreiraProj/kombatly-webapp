{
  "name": "taekwombats",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate --filter=@taekwombats/database",
    "db:migrate": "turbo run db:migrate --filter=@taekwombats/database",
    "db:seed": "turbo run db:seed --filter=@taekwombats/database",
    "db:studio": "turbo run db:studio --filter=@taekwombats/database",
    "db:reset": "turbo run db:reset --filter=@taekwombats/database",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "@types/node": "^22.10.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.1"
}
